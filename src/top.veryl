/// iCEstick top level: Blinky on the LEDs, plus a UART echo that sends every
/// byte received on the FTDI serial port (channel B) straight back.
module Top #(
    // 12 MHz clock / 1 Mbaud = 12 clock cycles per bit
    param CLKS_PER_BIT: u32 = 12,
) (
    clk: input  clock   ,
    rx : input  logic   ,
    tx : output logic   ,
    led: output logic<5>,
) {
    // Power-on reset. The iCEstick has no reset button, so hold reset for the
    // first 15 cycles after configuration, counting up from the all-zero state
    // iCE40 flip-flops power up in. Yosys needs this: without a reset it treats
    // the start state as unknown and may re-encode state machines so that
    // all-zero is not a valid state.
    var por_cnt: logic<4>;
    var rst    : reset   ;

    always_ff (clk) {
        if por_cnt != '1 {
            por_cnt += 1;
        }
    }

    assign rst = por_cnt != '1;

    var rx_data     : logic<8>;
    var rx_valid    : logic   ;
    var tx_busy     : logic   ;
    var tx_valid    : logic   ;
    var pending     : logic   ;
    var pending_data: logic<8>;

    inst u_blinky: Blinky (
        clk: clk,
        led: led,
    );

    inst u_rx: UartRx #(
        CLKS_PER_BIT: CLKS_PER_BIT,
    ) (
        i_clk  : clk     ,
        i_rst  : rst     ,
        i_rx   : rx      ,
        o_data : rx_data ,
        o_valid: rx_valid,
    );

    // One-byte buffer between receiver and transmitter. The two ends' clocks
    // differ slightly, so in a continuous stream a byte can arrive a cycle
    // before the previous echo has finished; hold it here instead of dropping it.
    always_ff (clk, rst) {
        if_reset {
            pending      = 0;
            pending_data = 0;
        } else {
            if rx_valid {
                pending      = 1;
                pending_data = rx_data;
            } else if tx_valid {
                pending = 0;
            }
        }
    }

    assign tx_valid = pending && !tx_busy;

    inst u_tx: UartTx #(
        CLKS_PER_BIT: CLKS_PER_BIT,
    ) (
        i_clk  : clk         ,
        i_rst  : rst         ,
        i_data : pending_data,
        i_valid: tx_valid    ,
        o_busy : tx_busy     ,
        o_tx   : tx          ,
    );
}
